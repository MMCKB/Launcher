<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinUI3Desktop.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <!-- Fluent 设置卡片：与 Windows 11 设置的 SettingsCard 同构 -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,14" />
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,20,0,6" />
            </Style>

            <Style x:Key="CardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="CardDescStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SettingSliderStyle" TargetType="Slider">
                <Setter Property="MinWidth" Value="240" />
                <Setter Property="MaxWidth" Value="300" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SliderValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="MinWidth" Value="48" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Background="Transparent">
            <TextBlock Text="启动台设置"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="14"
                       FontWeight="SemiBold" />
        </Grid>

        <NavigationView x:Name="Nav"
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="180"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.Resources>
                <ResourceDictionary>
                    <!-- 去掉模板自带的内容层填充与描边，让 Mica 贯通侧边栏与内容区（融合观感） -->
                    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentBackgroundBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                </ResourceDictionary>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="外观" Tag="Appearance" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="启动台" Tag="Launchpad">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="系统" Tag="System">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <!-- 外观 -->
                <ScrollViewer x:Name="AppearancePane"
                              Padding="36,28"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="18" MaxWidth="680" HorizontalAlignment="Left">
                        <TextBlock Text="主题" FontSize="16" FontWeight="SemiBold" />
                        <Border Style="{StaticResource CardStyle}" Margin="0,4">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="应用主题" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="跟随系统、强制浅色或深色" Style="{StaticResource CardDescStyle}" />
                                </StackPanel>
                                <StackPanel x:Name="ThemeButtons" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <RadioButton Content="跟随系统" GroupName="Theme" />
                                    <RadioButton Content="浅色" GroupName="Theme" />
                                    <RadioButton Content="深色" GroupName="Theme" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,6">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="材质" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="启动台面板与悬浮控件的背景质感" Style="{StaticResource CardDescStyle}" />
                                </StackPanel>
                                <StackPanel x:Name="MaterialButtons"
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <RadioButton Content="高斯模糊" GroupName="Material" />
                                    <RadioButton Content="亚克力" GroupName="Material" />
                                    <RadioButton Content="云母" GroupName="Material" />
                                    <RadioButton Content="液态玻璃" GroupName="Material" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,6">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="圆角" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="悬浮胶囊控件的圆角半径（0-40）" Style="{StaticResource CardDescStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Slider x:Name="CornerRadiusSlider"
                                            Style="{StaticResource SettingSliderStyle}"
                                            Minimum="0" Maximum="40" StepFrequency="1"
                                            ValueChanged="CornerRadiusSlider_ValueChanged"
                                            PointerCaptureLost="Slider_PointerCaptureLost" />
                                    <TextBlock x:Name="CornerRadiusValue" Style="{StaticResource SliderValueStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,6">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="材质不透明度" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="数值越低越透出壁纸" Style="{StaticResource CardDescStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Slider x:Name="OpacitySlider"
                                            Style="{StaticResource SettingSliderStyle}"
                                            Minimum="0.55" Maximum="1" StepFrequency="0.01"
                                            ValueChanged="OpacitySlider_ValueChanged"
                                            PointerCaptureLost="Slider_PointerCaptureLost" />
                                    <TextBlock x:Name="OpacityValue" Style="{StaticResource SliderValueStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,6">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="着色强度" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="材质层颜色的浓度" Style="{StaticResource CardDescStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Slider x:Name="TintSlider"
                                            Style="{StaticResource SettingSliderStyle}"
                                            Minimum="0" Maximum="1" StepFrequency="0.01"
                                            ValueChanged="TintSlider_ValueChanged"
                                            PointerCaptureLost="Slider_PointerCaptureLost" />
                                    <TextBlock x:Name="TintValue" Style="{StaticResource SliderValueStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="恢复默认" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="将材质与圆角重置为初始值" Style="{StaticResource CardDescStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="重置材质" Click="ResetMaterial_Click" />
                                    <Button Content="重置圆角" Click="ResetCornerRadius_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 启动台 -->
                <ScrollViewer x:Name="LaunchpadPane"
                              Padding="36,28"
                              Visibility="Collapsed"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="18" MaxWidth="680" HorizontalAlignment="Left">
                        <TextBlock Text="瓦片大小" FontSize="16" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Slider x:Name="TileSizeSlider"
                                    MinWidth="240" MaxWidth="300" VerticalAlignment="Center"
                                    Minimum="84" Maximum="128" StepFrequency="2"
                                    ValueChanged="TileSizeSlider_ValueChanged"
                                    PointerCaptureLost="Slider_PointerCaptureLost" />
                            <TextBlock x:Name="TileSizeValue" FontSize="13" VerticalAlignment="Center" MinWidth="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <TextBlock Text="呼出方式" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <ToggleSwitch x:Name="ShowLauncherButtonToggle"
                                      Header="显示底部启动按钮"
                                      Toggled="ShowLauncherButtonToggle_Toggled" />
                        <TextBlock Text="底部上滑手势（触屏呼出启动台）" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <StackPanel x:Name="SwipeButtons" Orientation="Horizontal" Spacing="8">
                            <RadioButton Content="自动（有触屏时开启）" GroupName="Swipe" />
                            <RadioButton Content="开启" GroupName="Swipe" />
                            <RadioButton Content="关闭" GroupName="Swipe" />
                        </StackPanel>

                        <TextBlock Text="快捷键：Ctrl + Alt + L 呼出/收起启动台；Esc 或点击空白处关闭。"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 系统 -->
                <ScrollViewer x:Name="SystemPane"
                              Padding="36,28"
                              Visibility="Collapsed"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="18" MaxWidth="680" HorizontalAlignment="Left">
                        <ToggleSwitch x:Name="TakeOverDesktopToggle"
                                      Header="隐藏系统任务栏（接管桌面）"
                                      Toggled="TakeOverDesktopToggle_Toggled" />
                        <TextBlock Text="关闭后系统任务栏保持可见，本应用只作为按需呼出的启动台覆盖层。"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <ToggleSwitch x:Name="AutoStartToggle"
                                      Header="开机自动启动"
                                      Margin="0,12,0,0"
                                      Toggled="AutoStartToggle_Toggled" />

                        <TextBlock Text="关于" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBlock Text="Launcher · WinUI 3 启动台重构版。配置保存在 %LOCALAPPDATA%\MyDock，旧版 Dock 配置会自动迁移。"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
