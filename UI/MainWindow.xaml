<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinUI3Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 深色底：壁纸解码前的窗口不再是白色 -->
    <Grid x:Name="RootGrid" Background="#FF0B1220" PointerPressed="RootGrid_PointerPressed">
        <Grid.Resources>
            <!-- 应用瓦片按钮：启动台/常用/运行区共用 -->
            <Style x:Key="AppTileButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!-- 悬浮控件（时钟/启动按钮）的胶囊样式，材质在代码里按主题填充 -->
            <Style x:Key="ChipButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="Background" Value="#CC17233A" />
                <Setter Property="BorderBrush" Value="#40FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="CornerRadius" Value="18" />
            </Style>
        </Grid.Resources>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="CloseAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control,Menu" Key="L" Invoked="ToggleAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <Image x:Name="WallpaperImage"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch" />

        <!-- 启动台：材质层在内容层之下（兄弟顺序保证层级），内容不被模糊 -->
        <Grid x:Name="LaunchpadRoot" Visibility="Collapsed" PointerPressed="LaunchpadRoot_PointerPressed">
            <Border x:Name="LaunchpadMaterialHost" Background="#CC17233A" />
            <Border x:Name="LaunchpadContent" Padding="0,66,0,46">
                <Grid RowSpacing="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBox x:Name="LaunchpadSearch"
                             Width="560"
                             Height="46"
                             FontSize="16"
                             CornerRadius="23"
                             HorizontalAlignment="Center"
                             PlaceholderText="搜索应用"
                             TextChanged="LaunchpadSearch_TextChanged" />

                    <StackPanel x:Name="RunningSection"
                                Grid.Row="1"
                                Margin="56,0"
                                Spacing="10"
                                Visibility="Collapsed">
                        <TextBlock Text="正在运行"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ScrollViewer HorizontalScrollMode="Enabled"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="RunningStrip" Orientation="Horizontal" Spacing="10" />
                        </ScrollViewer>
                    </StackPanel>

                    <ScrollViewer x:Name="AppsScroll"
                                  Grid.Row="2"
                                  Padding="56,0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="28">
                            <StackPanel x:Name="PinnedSection" Spacing="12" Visibility="Collapsed">
                                <TextBlock Text="常用"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ItemsRepeater x:Name="PinnedRepeater">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout x:Name="PinnedGridLayout" MinColumnSpacing="12" MinRowSpacing="12" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </StackPanel>

                            <StackPanel Spacing="12">
                                <TextBlock x:Name="AllAppsHeader"
                                           Text="全部应用"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ItemsRepeater x:Name="AppsRepeater">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout x:Name="AppsGridLayout" MinColumnSpacing="12" MinRowSpacing="12" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 控制中心浮层：点击卡片外关闭 -->
        <Grid x:Name="ControlCenterRoot" Visibility="Collapsed" PointerPressed="ControlCenterRoot_PointerPressed">
            <Grid x:Name="ControlCenterCard"
                  Width="380"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0,110,22,0">
                <Border x:Name="ControlCenterSurface"
                        CornerRadius="14"
                        BorderThickness="1"
                        BorderBrush="#40FFFFFF"
                        Padding="16">
                    <Grid>
                        <StackPanel x:Name="ControlCenterMainPanel" Spacing="14" Visibility="Visible">
                            <TextBlock Text="控制中心" FontSize="15" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Button x:Name="WifiTile" Click="WifiTile_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,12" CornerRadius="10" Background="#22FFFFFF" BorderThickness="0">
                                    <StackPanel Spacing="10">
                                        <FontIcon x:Name="WifiIcon" Glyph="&#xE701;" FontSize="20" />
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="WLAN" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock x:Name="WifiStateText" Text="检测中…" FontSize="11" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="WifiEntryButton"
                                        Width="28"
                                        Height="28"
                                        Margin="0,0,4,4"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Click="WifiEntryButton_Click"
                                        ToolTipService.ToolTip="搜索网络">
                                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                                </Button>
                            </Grid>
                            <Grid Grid.Column="1">
                                <Button x:Name="BluetoothTile" Grid.Column="1" Click="BluetoothTile_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,12" CornerRadius="10" Background="#22FFFFFF" BorderThickness="0">
                                    <StackPanel Spacing="10">
                                        <FontIcon x:Name="BluetoothIcon" Glyph="&#xE702;" FontSize="20" />
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="蓝牙" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock x:Name="BluetoothStateText" Text="检测中…" FontSize="11" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BluetoothEntryButton"
                                        Width="28"
                                        Height="28"
                                        Margin="0,0,4,4"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Click="BluetoothEntryButton_Click"
                                        ToolTipService.ToolTip="搜索设备">
                                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                                </Button>
                            </Grid>
                        </Grid>
                        <Border CornerRadius="10" Background="#22FFFFFF" Padding="14,10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="MuteButton" Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center" Click="MuteButton_Click">
                                    <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="18" />
                                </Button>
                                <Slider x:Name="VolumeSlider" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="100" ValueChanged="VolumeSlider_ValueChanged" />
                                <TextBlock x:Name="VolumeValueText" Grid.Column="2" Text="0" FontSize="13" VerticalAlignment="Center" MinWidth="34" TextAlignment="Right" Opacity="0.85" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="WifiListPanel" Spacing="10" Visibility="Collapsed">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="WifiBackButton" Background="Transparent" BorderThickness="0" Padding="4" Click="WifiBackButton_Click">
                                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                                </Button>
                                <TextBlock Grid.Column="1" Text="WLAN 网络" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button x:Name="WifiRescanButton" Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="4" Click="WifiRescanButton_Click" ToolTipService.ToolTip="重新扫描">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                </Button>
                            </Grid>
                            <TextBlock x:Name="WifiListStatus" Text="扫描中…" FontSize="12" Opacity="0.8" />
                            <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="WifiListHost" Spacing="4" />
                            </ScrollViewer>
                            <StackPanel x:Name="WifiConnectArea" Spacing="8" Visibility="Collapsed">
                                <TextBlock x:Name="WifiConnectTarget" Text="" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBox x:Name="WifiPasswordBox" PlaceholderText="输入网络密码" FontSize="12" Visibility="Collapsed" />
                                <Button x:Name="WifiConnectButton" Content="连接" HorizontalAlignment="Stretch" CornerRadius="8" Click="WifiConnectButton_Click" />
                                <Button x:Name="WifiDisconnectButton" Content="断开连接" HorizontalAlignment="Stretch" CornerRadius="8" Click="WifiDisconnectButton_Click" Visibility="Collapsed" />
                                <TextBlock x:Name="WifiConnectStatus" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="BluetoothListPanel" Spacing="10" Visibility="Collapsed">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BluetoothBackButton" Background="Transparent" BorderThickness="0" Padding="4" Click="BluetoothBackButton_Click">
                                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                                </Button>
                                <TextBlock Grid.Column="1" Text="蓝牙设备" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="BluetoothListStatus" Text="搜索设备中…" FontSize="12" Opacity="0.8" />
                            <ScrollViewer MaxHeight="330" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="BluetoothListHost" Spacing="4" />
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 状态时钟（右上，始终可见） -->
        <Button x:Name="ClockChip"
                Style="{StaticResource ChipButtonStyle}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,18,22,0"
                Click="ClockChip_Click">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock x:Name="ClockTime" FontSize="15" FontWeight="SemiBold" />
                <TextBlock x:Name="ClockDate" FontSize="13" Opacity="0.85" />
            </StackPanel>
        </Button>

        <!-- 控制中心按钮（时钟下方） -->
        <Button x:Name="ControlCenterButton"
                Style="{StaticResource ChipButtonStyle}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,64,22,0"
                Click="ControlCenterButton_Click"
                ToolTipService.ToolTip="控制中心">
            <FontIcon Glyph="&#xE753;" FontSize="16" />
        </Button>

        <!-- 底部上滑热区（触屏呼出启动台） -->
        <Rectangle x:Name="BottomEdgeZone"
                   Height="24"
                   VerticalAlignment="Bottom"
                   Fill="Transparent"
                   ManipulationMode="TranslateY,TranslateRailsY"
                   ManipulationDelta="BottomEdgeZone_ManipulationDelta"
                   ManipulationCompleted="BottomEdgeZone_ManipulationCompleted" />

        <!-- 启动台呼出按钮（底部居中悬浮） -->
        <Button x:Name="LauncherButton"
                Style="{StaticResource ChipButtonStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,18"
                Click="LauncherButton_Click"
                ToolTipService.ToolTip="启动台 (Ctrl+Alt+L)">
            <FontIcon Glyph="&#xE71D;" FontSize="18" />
        </Button>
    </Grid>
</Window>
