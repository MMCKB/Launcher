<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinUI3Desktop.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUI3Desktop"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="SettingsRoot" Background="Transparent">
        <!-- WinUI3 Custom Title Bar -->
        <Grid x:Name="AppTitleBar"
              Height="48"
              VerticalAlignment="Top"
              Background="Transparent">
        </Grid>

        <NavigationView x:Name="SettingsNavigation"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="True"
                        IsPaneOpen="True"
                        OpenPaneLength="240"
                        CompactPaneLength="64"
                        PaneTitle=""
                        SelectionChanged="SettingsNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="外观" Tag="Appearance">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE771;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Dock" Tag="Dock" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A7;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="布局" Tag="Layout">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE790;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="交互" Tag="Interaction">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8FB;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="应用" Tag="Apps">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A7;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="系统" Tag="System">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE770;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Border Padding="48,36,56,48">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="840" Spacing="0">
                        <TextBlock Text="设置" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock x:Name="PageTitleText" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,6" />
                        <TextBlock x:Name="PageDescriptionText" FontSize="14" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,28" />

                        <StackPanel x:Name="DockSettingsPanel" Spacing="16" Visibility="Visible">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="20">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="锁定 Dock 栏" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="锁定后无法通过拖拽、应用抽屉或此页面添加/移除 Dock 应用。"
                                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <ToggleSwitch x:Name="LockDockToggle" Toggled="LockDockToggle_Toggled" />
                                        <Button Content="恢复默认" Click="ResetLockDock_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="20">
                                <StackPanel Spacing="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Dock 材质" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="默认使用高斯模糊；每种材质均有独立可调参数。"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="恢复默认" Click="ResetMaterial_Click" />
                                    </Grid>

                                    <ComboBox x:Name="MaterialComboBox" SelectionChanged="MaterialComboBox_SelectionChanged">
                                        <ComboBoxItem Content="高斯模糊" Tag="GaussianBlur" />
                                        <ComboBoxItem Content="亚克力（Acrylic）" Tag="Acrylic" />
                                        <ComboBoxItem Content="云母（Mica）" Tag="Mica" />
                                        <ComboBoxItem Content="液态玻璃" Tag="LiquidGlass" />
                                    </ComboBox>

                                    <Border x:Name="MaterialParameterPanel"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            CornerRadius="10" Padding="16">
                                        <StackPanel Spacing="14">
                                            <TextBlock Text="材质参数" FontWeight="SemiBold" />
                                            <Grid x:Name="BlurSettingRow" ColumnSpacing="16">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="模糊度" />
                                                    <TextBlock Text="数值越高，背景细节越弱。" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <NumberBox x:Name="BlurNumberBox" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1"
                                                           SpinButtonPlacementMode="Compact" ValueChanged="BlurNumberBox_ValueChanged" />
                                            </Grid>
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="透明度" />
                                                    <TextBlock Text="控制 Dock 和抽屉的整体通透程度。" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <NumberBox x:Name="OpacityNumberBox" Grid.Column="1" Minimum="0.2" Maximum="0.98" SmallChange="0.02"
                                                           SpinButtonPlacementMode="Compact" ValueChanged="OpacityNumberBox_ValueChanged" />
                                            </Grid>
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock x:Name="TintParameterTitleText" Text="颜色混合度" />
                                                    <TextBlock x:Name="TintParameterDescriptionText" Text="控制材质颜色与桌面背景的混合程度。" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <NumberBox x:Name="TintNumberBox" Grid.Column="1" Minimum="0.1" Maximum="0.95" SmallChange="0.05"
                                                           SpinButtonPlacementMode="Compact" ValueChanged="TintNumberBox_ValueChanged" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="20">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="更改 Dock" FontSize="16" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Dock 圆角" />
                                            <TextBlock Text="控制 Dock 外轮廓圆角。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <NumberBox x:Name="CornerRadiusNumberBox" Grid.Column="1" Minimum="0" Maximum="48" SmallChange="1"
                                                   SpinButtonPlacementMode="Compact" ValueChanged="CornerRadiusNumberBox_ValueChanged" />
                                        <Button Grid.Column="2" Content="恢复默认" Click="ResetCornerRadius_Click" />
                                    </Grid>
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="应用抽屉分体展示" />
                                            <TextBlock Text="关闭时，抽屉从 Dock 向上滑出；开启时，抽屉与 Dock 上下分开并使用弹出动画。"
                                                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <ToggleSwitch x:Name="SeparateDrawerToggle" Toggled="SeparateDrawerToggle_Toggled" />
                                            <Button Content="恢复默认" Click="ResetSeparateDrawer_Click" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid x:Name="DrawerGapPanel" ColumnSpacing="16" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Dock 与应用抽屉间距" />
                                            <TextBlock Text="仅在分体展示时可用。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <NumberBox x:Name="DrawerGapNumberBox" Grid.Column="1" Minimum="0" Maximum="80" SmallChange="1"
                                                   SpinButtonPlacementMode="Compact" ValueChanged="DrawerGapNumberBox_ValueChanged" />
                                        <Button Grid.Column="2" Content="恢复默认" Click="ResetDrawerGap_Click" />
                                    </Grid>
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="抽屉搜索框位置" />
                                            <TextBlock Text="搜索范围仅限应用抽屉读取到的系统应用和自定义应用。" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ComboBox x:Name="SearchPositionComboBox" Grid.Column="1" SelectionChanged="SearchPositionComboBox_SelectionChanged">
                                            <ComboBoxItem Content="上方" Tag="Top" />
                                            <ComboBoxItem Content="下方" Tag="Bottom" />
                                        </ComboBox>
                                        <Button Grid.Column="2" Content="恢复默认" Click="ResetSearchPosition_Click" />
                                    </Grid>
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="80" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="每页应用网格" />
                                            <TextBlock Text="设置应用抽屉每页的行数与列数。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <NumberBox x:Name="DrawerRowsNumberBox" Grid.Column="1" Minimum="1" Maximum="6" SmallChange="1"
                                                   Header="行" SpinButtonPlacementMode="Compact" ValueChanged="DrawerRowsNumberBox_ValueChanged" />
                                        <NumberBox x:Name="DrawerColumnsNumberBox" Grid.Column="2" Minimum="3" Maximum="10" SmallChange="1"
                                                   Header="列" SpinButtonPlacementMode="Compact" ValueChanged="DrawerColumnsNumberBox_ValueChanged" />
                                        <Button Grid.Column="3" Content="恢复默认" Click="ResetDrawerGrid_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="20">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Dock 应用" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="未锁定时，可从系统应用列表选择、选择 EXE 文件，或从应用抽屉拖拽应用到 Dock。"
                                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <ComboBox x:Name="SystemApplicationComboBox" DisplayMemberPath="Name" PlaceholderText="选择系统应用" />
                                        <Button Grid.Column="1" Content="添加到 Dock" Click="AddSelectedApplication_Click" />
                                    </Grid>
                                    <Button Content="选择 EXE 文件并添加" HorizontalAlignment="Left" Click="AddCustomExe_Click" />
                                    <ListView x:Name="DockApplicationList" Height="170" DisplayMemberPath="Name" SelectionMode="Single" />
                                    <Button Content="从 Dock 移除所选应用" HorizontalAlignment="Left" Click="RemoveSelectedApplication_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border x:Name="PlaceholderPanel" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="24" Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <FontIcon Glyph="&#xE713;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="功能将在后续版本中加入" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="当前页面仅搭建导航与视觉布局，尚未写入其他应用设置。"
                                           FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </NavigationView>
    </Grid>
</Window>
