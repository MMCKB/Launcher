<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinUI3Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUI3Desktop"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.Resources>
        <AcrylicBrush x:Key="DockGlassBrush"
                      BackgroundSource="Backdrop"
                      TintColor="#FF17243C"
                      TintOpacity="0.76"
                      FallbackColor="#E817243C" />

        <SolidColorBrush x:Key="DockBorderBrush" Color="#52FFFFFF" />
        <SolidColorBrush x:Key="DockIconForeground" Color="#FFF8FAFF" />

        <Style x:Key="DockButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="60" />
            <Setter Property="Height" Value="68" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="Transparent">
        <Image x:Name="WallpaperImage"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch" />

        <Border x:Name="DockHint"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,126"
                Padding="14,7"
                Background="#E6192740"
                BorderBrush="#35FFFFFF"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="Collapsed">
            <TextBlock x:Name="DockHintText"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#FFF4F7FF" />
        </Border>

        <Grid x:Name="DockHost"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Margin="0,0,0,28"
              PointerMoved="DockHost_PointerMoved"
              PointerExited="DockHost_PointerExited">
            <Border x:Name="DockSurface"
                    Padding="10,8"
                    Background="{StaticResource DockGlassBrush}"
                    BorderBrush="{StaticResource DockBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="24">
                <StackPanel x:Name="DockPanel" Orientation="Horizontal" Spacing="4">
                    <Button x:Name="LauncherDockButton"
                            Tag="启动器"
                            Style="{StaticResource DockButtonStyle}"
                            Click="DockButton_Click"
                            RightTapped="DockButton_RightTapped"
                            ToolTipService.ToolTip="启动器">
                        <Grid Width="52" Height="60">
                            <Border Width="48" Height="48" CornerRadius="14" Background="#FF397DF4">
                                <FontIcon Glyph="&#xE700;" FontSize="24" Foreground="{StaticResource DockIconForeground}" />
                            </Border>
                            <Ellipse Width="5" Height="5" Fill="#FFB6C8FF" VerticalAlignment="Bottom" />
                        </Grid>
                    </Button>

                    <Button x:Name="BrowserDockButton"
                            Tag="浏览器"
                            Style="{StaticResource DockButtonStyle}"
                            Click="DockButton_Click"
                            RightTapped="DockButton_RightTapped"
                            ToolTipService.ToolTip="浏览器">
                        <Grid Width="52" Height="60">
                            <Border Width="48" Height="48" CornerRadius="14" Background="#FF38A86A">
                                <FontIcon Glyph="&#xE774;" FontSize="24" Foreground="{StaticResource DockIconForeground}" />
                            </Border>
                            <Ellipse Width="5" Height="5" Fill="#FFB6C8FF" VerticalAlignment="Bottom" />
                        </Grid>
                    </Button>

                    <Button x:Name="FilesDockButton"
                            Tag="文件"
                            Style="{StaticResource DockButtonStyle}"
                            Click="DockButton_Click"
                            RightTapped="DockButton_RightTapped"
                            ToolTipService.ToolTip="文件">
                        <Grid Width="52" Height="60">
                            <Border Width="48" Height="48" CornerRadius="14" Background="#FFF2AA35">
                                <FontIcon Glyph="&#xE8B7;" FontSize="24" Foreground="#FFFDF9F0" />
                            </Border>
                            <Ellipse Width="5" Height="5" Fill="#FFB6C8FF" VerticalAlignment="Bottom" />
                        </Grid>
                    </Button>

                    <Button x:Name="NotesDockButton"
                            Tag="笔记"
                            Style="{StaticResource DockButtonStyle}"
                            Click="DockButton_Click"
                            RightTapped="DockButton_RightTapped"
                            ToolTipService.ToolTip="笔记">
                        <Grid Width="52" Height="60">
                            <Border Width="48" Height="48" CornerRadius="14" Background="#FF9B6AF2">
                                <FontIcon Glyph="&#xE70F;" FontSize="24" Foreground="{StaticResource DockIconForeground}" />
                            </Border>
                            <Ellipse Width="5" Height="5" Fill="#FFB6C8FF" VerticalAlignment="Bottom" />
                        </Grid>
                    </Button>

                    <Button x:Name="MusicDockButton"
                            Tag="音乐"
                            Style="{StaticResource DockButtonStyle}"
                            Click="DockButton_Click"
                            RightTapped="DockButton_RightTapped"
                            ToolTipService.ToolTip="音乐">
                        <Grid Width="52" Height="60">
                            <Border Width="48" Height="48" CornerRadius="14" Background="#FFE45476">
                                <FontIcon Glyph="&#xE8D6;" FontSize="24" Foreground="{StaticResource DockIconForeground}" />
                            </Border>
                            <Ellipse Width="5" Height="5" Fill="#FFB6C8FF" VerticalAlignment="Bottom" />
                        </Grid>
                    </Button>

                    <Border Width="1" Height="40" Margin="5,0" VerticalAlignment="Center" Background="#35FFFFFF" />

                    <Button x:Name="SettingsDockButton"
                            Tag="设置"
                            Style="{StaticResource DockButtonStyle}"
                            Click="DockButton_Click"
                            RightTapped="DockButton_RightTapped"
                            ToolTipService.ToolTip="设置">
                        <Grid Width="52" Height="60">
                            <Border Width="48" Height="48" CornerRadius="14" Background="#FF66748C">
                                <FontIcon Glyph="&#xE713;" FontSize="24" Foreground="{StaticResource DockIconForeground}" />
                            </Border>
                            <Ellipse Width="5" Height="5" Fill="#FFB6C8FF" VerticalAlignment="Bottom" />
                        </Grid>
                    </Button>

                    <Button x:Name="RecycleDockButton"
                            Tag="回收站"
                            Style="{StaticResource DockButtonStyle}"
                            Click="DockButton_Click"
                            RightTapped="DockButton_RightTapped"
                            ToolTipService.ToolTip="回收站">
                        <Grid Width="52" Height="60">
                            <Border Width="48" Height="48" CornerRadius="14" Background="#FF4D7D92">
                                <FontIcon Glyph="&#xE74D;" FontSize="24" Foreground="{StaticResource DockIconForeground}" />
                            </Border>
                            <Ellipse Width="5" Height="5" Fill="#FFB6C8FF" VerticalAlignment="Bottom" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
